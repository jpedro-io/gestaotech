# ─── Banco (Neon) ────────────────────────────────────────────────────────────
# Cole aqui a connection string do Neon (Dashboard → Connection string).
# Use a versão "Pooled connection" com sslmode=require.
# Deixe VAZIO para usar o SQLite local; cole a do Neon para usar o Postgres.
DATABASE_URL=

# ─── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=troque-esta-chave
DEBUG=1
ALLOWED_HOSTS=*   # em produção: seu-dominio.com
CSRF_TRUSTED_ORIGINS=

# ─── Certificados ───────────────────────────────────────────────────────────
# Endereço público: entra no rodapé do certificado e no QR Code.
SITE_URL=http://localhost:8000
# Antes dessa data a busca responde "ainda não liberados".
DATA_LIBERACAO=2000-01-01
# Pepper do hash do CPF — NÃO mude depois que o banco estiver populado.
CPF_PEPPER=gere-uma-string-aleatoria-longa
LIBREOFFICE_TIMEOUT=90
# Caminho do LibreOffice, se o 'soffice' não estiver no PATH (ex.: Windows).
# Ex.: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_BIN=
