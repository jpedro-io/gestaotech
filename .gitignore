# ── segredos: NUNCA subir ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── DADOS PESSOAIS: nunca versionar ────────────────────────────────────────
# CSVs de participantes têm nome + CPF completos (LGPD).
# Guarde-os fora do repositório (ex.: OneDrive/Documentos/gestao-tech-dados).
importacao/*.csv
importacao/*.json
importacao/*.xlsx
importacao/*.ods
# exceto o modelo de exemplo, com dados fictícios
!importacao/exemplo.csv

